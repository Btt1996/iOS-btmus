{
	"appId": "com.ahmed.btmu",
	"appName": "btmu",
	"webDir": "dist",
	"server": {
		"iosScheme": "capacitor"
	},
	"ios": {
		"contentInset": "automatic",
		"preferredContentMode": "mobile"
	},
	"plugins": {
		"StatusBar": {
			"style": "DARK",
			"overlaysWebView": true
		},
		"CapacitorHttp": {
			"enabled": true
		}
	},
	"packageClassList": [
		"AppPlugin",
		"HapticsPlugin",
		"StatusBarPlugin"
	]
}
